#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&kp N1      &kp N2  &kp N3  &kp N4  &kp N5      &kp N6  &kp N7  &kp N8     &kp N9   &kp N0
&kp Q       &kp W   &kp E   &kp R   &kp T       &kp Y   &kp U   &kp I      &kp O    &kp P
&kp A       &kp S   &kp D   &kp F   &kp G       &kp H   &kp J   &kp K      &kp L    &kp SEMI
&mt LSHFT Z &kp X   &kp C   &kp V   &kp B       &kp N   &kp M   &kp COMMA  &kp DOT  &mt RSHFT FSLH
                                &lt 1 SPACE     &kp BSPC
            >;
        };

        fn_layer {
            display-name = "Fn";
            bindings = <
&kp ESC     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_CLR    &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT  &kp BSLH
&kp TAB     &trans       &trans       &trans       &trans        &trans    &trans    &kp UP    &trans    &kp DEL
&kp LCTRL   &kp LALT     &kp LGUI     &trans       &trans        &trans    &kp LEFT  &kp DOWN  &kp RIGHT &kp SQT
&kp LSHFT   &trans       &trans       &trans       &trans        &trans    &kp GRAVE &trans    &trans    &kp RET
                                              &trans    &kp RET
            >;
        };
    };
};
